APP_PORT=80
APP_ENV=production
DATABASE_URL=postgresql://prod-user:prod-pass@prod-db:5432/kreatif_dms?sslmode=verify-full
REDIS_URL=prod-redis:6379

JWT_SECRET=PROD_SECRET_KEY_CHANGE_ME_NOW
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

MINIO_ENDPOINT=s3.amazonaws.com
MINIO_ACCESS_KEY=prod-access-key
MINIO_SECRET_KEY=prod-secret-key
MINIO_USE_SSL=true
MINIO_BUCKET=kreatif-dms-prod

ELASTICSEARCH_URL=https://prod-es:9243

OCR_SERVICE_URL=https://prod-ocr-api.kreatif.id

APP_PREFORK=true
RATE_LIMIT_MAX=100
RATE_LIMIT_EXPIRATION=1m

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=prod@kreatif.id
SMTP_PASS=PROD_SMTP_PASS_CHANGE_ME

LDAP_ENABLED=false
LDAP_URL=ldap://prod-ad-server:389
LDAP_BASE_DN=dc=kreatif,dc=id
LDAP_BIND_DN=cn=admin,dc=kreatif,dc=id
LDAP_BIND_PASS=PROD_LDAP_PASS_CHANGE_ME
LDAP_USER_FILTER=(&(objectClass=person)(sAMAccountName=%s))
