APP_PORT=8080
APP_ENV=staging
DATABASE_URL=postgresql://root:secretpassword@staging-db:5432/kreatif_dms?sslmode=disable
REDIS_URL=staging-redis:6379

JWT_SECRET=stagingsecretkey
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

MINIO_ENDPOINT=staging-minio:9000
MINIO_ACCESS_KEY=rootadmin
MINIO_SECRET_KEY=secretpassword
MINIO_USE_SSL=true
MINIO_BUCKET=documents

ELASTICSEARCH_URL=http://staging-es:9200

OCR_SERVICE_URL=http://staging-ocr:8000

APP_PREFORK=true
RATE_LIMIT_MAX=100
RATE_LIMIT_EXPIRATION=1m

SMTP_HOST=staging-mail
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

LDAP_ENABLED=false
LDAP_URL=ldap://staging-ad:389
LDAP_BASE_DN=dc=staging,dc=com
LDAP_BIND_DN=cn=admin,dc=staging,dc=com
LDAP_BIND_PASS=stagingpassword
LDAP_USER_FILTER=(&(objectClass=person)(uid=%s))
